{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "T3_music_pack.schema.json",
  "title": "RESTAURATION-T3 music pack",
  "type": "object",
  "required": ["schema_version", "template_id", "pack_version", "id", "status", "audio_profile", "selection_contract", "license_contract", "tracks", "quality_gates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "template_id": {"const": "RESTAURATION-T3"},
    "pack_version": {"const": "1.0.0"},
    "audio_profile": {"const": "afrobeat_amapiano"},
    "id": {"type": "string"},
    "status": {"const": "all_four_owner_approved_final_render_D"},
    "selection_contract": {
      "type": "object",
      "required": ["variant_count", "allowed_variant_ids", "owner_approved_variant_ids", "final_render_choice", "final_render_variant_id", "runtime_mode", "automatic_selection", "reference_render"],
      "properties": {
        "variant_count": {"const": 4},
        "allowed_variant_ids": {"const": ["t3_music_481806", "t3_music_360659", "t3_music_485507", "t3_music_245452"]},
        "owner_approved_variant_ids": {"const": ["t3_music_481806", "t3_music_360659", "t3_music_485507", "t3_music_245452"]},
        "final_render_choice": {"const": "D"},
        "final_render_variant_id": {"const": "t3_music_245452"},
        "runtime_mode": {"const": "automatic and explicit production selection follow the strict success cycle 1→2→3→4→1; reference render D remains a canonical exemplar only"},
        "automatic_selection": {
          "type": "object",
          "required": ["algorithm", "first_render_pool", "subsequent_pool", "explicit_selection_policy", "idempotency_ledger_key", "state_update_policy", "failed_render_state_policy", "persistent_state_schema", "state_writer", "offline", "implementation"],
          "properties": {
            "algorithm": {"const": "strict approved order 1→2→3→4→1 from last successful variant"},
            "first_render_pool": {"const": "first_owner_approved_variant_only"},
            "subsequent_pool": {"const": "single_next_variant_in_approved_order"},
            "explicit_selection_policy": {"const": "exact_successor_only"},
            "idempotency_ledger_key": {"const": "successful_render_jobs"},
            "state_update_policy": {"const": "after_success_only"},
            "failed_render_state_policy": {"const": "unchanged"},
            "persistent_state_schema": {"const": "schemas/T3_music_selection_state.schema.json"},
            "state_writer": {"const": "tools/record_t3_music_result.py"},
            "offline": {"const": true},
            "implementation": {"const": "adapter/t3_adapter.py"}
          }
        },
        "reference_render": {
          "type": "object",
          "required": ["choice", "variant_id", "purpose"],
          "properties": {"choice": {"const": "D"}, "variant_id": {"const": "t3_music_245452"}}
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "choice", "pixabay_id", "file", "sha256", "source_page", "source_evidence_file", "audition_approved_by_owner", "production_eligible"]
      }
    }
  }
}
