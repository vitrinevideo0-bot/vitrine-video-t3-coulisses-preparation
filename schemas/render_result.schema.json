{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "render_result.schema.json",
  "title": "RESTAURATION-T3 RenderResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "template_id", "template_version", "status", "output", "music_variant_id", "input_capture_sha256", "qc"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "job_id": {"type": "string"},
    "template_id": {"const": "RESTAURATION-T3"},
    "template_version": {"const": "1.0.0"},
    "status": {"const": "COMPLETED"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "bytes", "duration_s", "frames", "width", "height", "fps", "audio_sample_rate_hz", "audio_channels"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "duration_s": {"const": 30.0}, "frames": {"const": 900}, "width": {"const": 720}, "height": {"const": 1280}, "fps": {"const": 30},
        "audio_sample_rate_hz": {"const": 48000}, "audio_channels": {"const": 2}
      }
    },
    "music_variant_id": {"enum": ["t3_music_481806", "t3_music_360659", "t3_music_485507", "t3_music_245452"]},
    "input_capture_sha256": {
      "type": "object", "additionalProperties": false, "required": ["S1", "S2", "S3", "S4"],
      "properties": {"S1": {"$ref": "#/$defs/hash"}, "S2": {"$ref": "#/$defs/hash"}, "S3": {"$ref": "#/$defs/hash"}, "S4": {"$ref": "#/$defs/hash"}}
    },
    "qc": {
      "type": "object", "additionalProperties": false, "required": ["status", "checks_passed", "checks_failed", "visual_stream_sha256", "clipped_samples"],
      "properties": {
        "status": {"const": "PASS"}, "checks_passed": {"type": "integer", "minimum": 1}, "checks_failed": {"const": 0},
        "visual_stream_sha256": {"$ref": "#/$defs/hash"}, "clipped_samples": {"const": 0}
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
